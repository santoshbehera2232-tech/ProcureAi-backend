{
  "name": "tiitans-procurement-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "node backend/src/server.js",
    "build": "cd frontend && npm run build",
    "test": "cd backend && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
